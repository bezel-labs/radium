{
  "name": "radium",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "homepage": "https://bezel.new/?utm_source=github&utm_medium=referral&utm_content=homepage",
  "scripts": {
    "build": "npm run tokens && turbo build && rm -rf dist && cp -r apps/storybook/dist dist",
    "dev": "npm run tokens && turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "storybook": "npm run tokens && npm run dev --workspace=@radium/storybook",
    "build:storybook": "npm run tokens && npm run build --workspace=@radium/storybook",
    "tokens": "bezel build"
  },
  "devDependencies": {
    "@bezel-labs/bezel-kit": "^0.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
